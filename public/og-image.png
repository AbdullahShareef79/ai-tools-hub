<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#eff6ff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#f0fdf4;stop-opacity:1" />
    </linearGradient>
  </defs>
  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bg)" />
  <!-- Top accent bar -->
  <rect width="1200" height="8" fill="#2563eb" />
  <!-- Logo icon -->
  <text x="100" y="270" font-size="80" font-family="system-ui, sans-serif">⚡</text>
  <!-- Site name -->
  <text x="100" y="330" font-size="56" font-weight="800" font-family="system-ui, sans-serif" fill="#0f172a">AI Tools Hub</text>
  <!-- Tagline -->
  <text x="100" y="390" font-size="30" font-family="system-ui, sans-serif" fill="#475569">Discover &amp; Compare the Best AI Tools</text>
  <!-- Subtext -->
  <text x="100" y="440" font-size="22" font-family="system-ui, sans-serif" fill="#64748b">Honest reviews · Expert comparisons · Updated 2026</text>
  <!-- Decorative dots -->
  <circle cx="1050" cy="200" r="120" fill="#2563eb" opacity="0.08" />
  <circle cx="1100" cy="450" r="80" fill="#10b981" opacity="0.08" />
  <!-- Bottom domain -->
  <text x="100" y="570" font-size="20" font-family="system-ui, sans-serif" fill="#94a3b8">ai-tools-hub-beryl.vercel.app</text>
</svg>
